# Copy to .env and adjust. Every value here has a working local default.
DATABASE_URL=postgresql+psycopg://duatangan:duatangan@localhost:5432/duatangan
# Use a long random string anywhere other than your laptop: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying
JWT_EXPIRES_DAYS=30
# JSON list of allowed web origins. "*" is fine for local development.
CORS_ORIGINS=["*"]
# Create the Nadia & Reza demo family when the database is empty.
SEED_DEMO=true
# Time zone of the demo family. Leave unset to use this computer's time zone.
# DEMO_TIME_ZONE=Asia/Jakarta
